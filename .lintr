linters: linters_with_defaults(line_length_linter(120), assignment_linter = NULL, brace_linter = NULL, commas_linter = NULL, commented_code_linter = NULL, indentation_linter = NULL, infix_spaces_linter = NULL, object_name_linter = NULL, paren_body_linter = NULL, pipe_continuation_linter = NULL, quotes_linter = NULL, return_linter = NULL, semicolon_linter = NULL, spaces_inside_linter = NULL, spaces_left_parentheses_linter = NULL, trailing_blank_lines_linter = NULL, trailing_whitespace_linter = NULL)
exclusions: list("data-raw", "inst/deprecated", "inst/doc", "R/generatedContrastsDF.r")


