\title{Protein contrasts from the median peptide p-value (PECA/ROPECA derivation)}
\value{
An R6 class generator.
}
\description{
Aggregates peptide-level contrasts to the protein level. The protein fold change is the median peptide fold
change; the protein p-value comes from the median of the signed peptide p-values, corrected with the beta
distribution of the median of \code{n} uniform p-values (\code{n} peptides, at most 10). This follows the
peptide-median method of PECA and ROPECA (Suomi and Elo 2017); unlike ROPECA, the peptide statistics are not
reproducibility-optimized (no ROTS). \link{ContrastsROPECANestedFacade} lists the differences and compares the
result with PECA.
}
\examples{

istar <- prolfqua::sim_lfq_data_peptide_config(n_proteins=20)
istar_data <- istar$data
modelFunction <-
  strategy_lm("abundance  ~ group_")
pepIntensity <- istar_data
config <- istar$config$clone(deep = TRUE)
config$hierarchy_depth <- 2
config$hierarchy_keys_depth()

mod <- build_model(
 pepIntensity,
 modelFunction,
 subject_id = config$hierarchy_keys_depth())

 Contr <- c("AvsCtrl" = "group_A - group_Ctrl")


 contr <- prolfqua::Contrasts$new(mod, Contr)
 dim(contr$get_contrasts())
 contrM <- prolfqua::ContrastsModerated$new(contr)
 dim(contrM$get_contrasts())
 contrast <- prolfqua::ContrastsROPECA$new(contrM)
 contrast$get_contrasts()
 contrast <- prolfqua::ContrastsROPECA$new(contr)
 tmp <- contrast$get_contrasts()
 dim(tmp)
 pl <- contrast$get_Plotter()
 contrast$to_wide()
 contrast$get_linfct()
 contrast$get_contrast_sides()
 pl$histogram()
 pl$ma_plot()

}
