\description{
A contrast object around a ready-made contrast table, for example the result of \code{\link[=merge_contrasts_results]{merge_contrasts_results()}}. It
provides the shared methods of \link{ContrastsInterface} (plots, wide format, ranking) but no linear functions, because
no model stands behind it.
}
\examples{

istar <- prolfqua::sim_lfq_data_protein_config(n_proteins = 30)
lfqdata <- LFQData$new(istar$data, istar$config)
lfqdata$rename_response("transformedIntensity")
Contrasts <- c("aC" = "group_A - group_Ctrl",
"bC" = "group_B - group_Ctrl")
fa <- ContrastsLMFacade$new(lfqdata, "~ group_", Contrasts)
ctr <- fa$get_contrasts()
fa$contrast$subject_id
xcx <- ContrastsTable$new(ctr, subject_id = fa$contrast$subject_id, model_name = "TableTest")
xcx$get_contrasts()
xcx$get_Plotter()$volcano()
stopifnot(is.null(xcx$get_contrast_sides()))
stopifnot(is.null(xcx$get_linfct()))
stopifnot(ncol(xcx$to_wide()) == 9)

}
